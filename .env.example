# Salin file ini menjadi .env (lokal saja), isi nilainya. JANGAN commit .env.
# Untuk Edge Function, set lewat: supabase secrets set NAMA=nilai

# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=

# API key dari Google AI Studio
GEMINI_API_KEY=

# Teks acak buatan sendiri; dipakai untuk memverifikasi webhook Telegram
TELEGRAM_WEBHOOK_SECRET=

# Catatan:
# - SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY sudah otomatis tersedia di Edge Function.
# - Service role key TIDAK BOLEH ada di kode frontend atau di repo.
# - Di frontend (assets/app.js) hanya boleh memakai SUPABASE_URL dan ANON key.

